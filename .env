# NEXORA environment example (copy to .env and fill values)

# General
NODE_ENV=development
APP_NAME=NEXORA
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PREFIX=/api/v1

# Web (Next.js)
NEXT_PUBLIC_APP_NAME=NEXORA
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000

# API (NestJS)
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://nexora:nexora_password@localhost:5432/nexora?schema=public
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora_password
POSTGRES_DB=nexora

# Redis
REDIS_URL=redis://localhost:6379

# Auth / Sessions
SESSION_SECRET=replace_with_strong_random_secret
SESSION_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_LENGTH=6

# Email (transactional provider / SMTP - configure for OTP delivery)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_me
SMTP_PASS=replace_me
EMAIL_FROM="NEXORA <no-reply@example.com>"

# Media storage (S3-compatible, private/encrypted objects only)
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=nexora-media
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
S3_FORCE_PATH_STYLE=true
MEDIA_DOWNLOAD_URL_TTL_SECONDS=300

# Security / Crypto (use audited protocol libraries; do NOT implement homemade crypto)
# Configure according to chosen Signal/MLS library integration
E2EE_IDENTITY_KEY_ROTATION_DAYS=30
E2EE_PREKEY_BATCH_SIZE=100

# Deployment / Reverse proxy
TRUST_PROXY=true
